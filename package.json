{
  "name": "niryk-tales-of-rondoria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Niryk: Tales of Rondoria - MMORPG sandbox 2.5D isometrico para web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "node tools/raw-models.mjs && vite build --mode single && node tools/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "shoot": "node tools/shoot.mjs",
    "models": "node tools/import-models.mjs",
    "art": "python3 tools/art2d/build_all.py"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.2.7",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.180.0",
    "meshoptimizer": "0.25.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.7"
  }
}
